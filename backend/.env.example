# Copy to .env and fill in. Every value is read from the environment; nothing
# else is a configuration source. All variables below are optional except
# DATABASE_URL and JWT_SECRET.

# --- Core ---
APP_ENV=development            # development | production
HTTP_ADDR=:8080
LOG_LEVEL=info                 # debug | info | warn | error
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=60s

# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/weight_buddy?sslmode=disable

# --- Sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=720h

# --- Abuse protection ---
FREE_ACCOUNTS_PER_DEVICE=1
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30
DAILY_SPEND_CAP_USD=25

# --- AI provider (the key lives here, never on the device) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PARSE_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-transcribe
AI_TIMEOUT=90s

# --- RevenueCat ---
# The value set as the Authorization header on the RevenueCat webhook config.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_ENTITLEMENT=pro
