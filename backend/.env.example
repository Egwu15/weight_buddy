# Copy to .env and fill in. Every value is read from the environment; nothing
# else is a configuration source. All variables below are optional except
# DATABASE_URL and JWT_SECRET.
#
# Do NOT add trailing inline comments: systemd's EnvironmentFile keeps them as
# part of the value (only lines that START with # are comments), which makes
# the value invalid and the service crash-loop at startup.

# --- Core ---
# development | production
APP_ENV=development
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=60s

# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/weight_buddy?sslmode=disable

# --- Sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=720h

# --- Google Sign-In ---
# The OAuth *Web* client id. Google ID tokens must be minted for this audience.
GOOGLE_WEB_CLIENT_ID=

# --- Abuse protection ---
FREE_ACCOUNTS_PER_DEVICE=1
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30
# Networks whose X-Forwarded-For is trusted (Caddy on localhost by default).
# Comma-separated CIDRs or IPs; the literal "none" trusts nothing.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
DAILY_SPEND_CAP_USD=25

# --- AI provider (the key lives here, never on the device) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PARSE_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-transcribe
AI_TIMEOUT=90s

# --- RevenueCat ---
# The value set as the Authorization header on the RevenueCat webhook config.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=pro
