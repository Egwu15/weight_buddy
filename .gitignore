# Repository-wide ignores. The Flutter app has its own mobile/.gitignore.

# OS / editor noise
.DS_Store
*.log
.idea/
*.iml

# Environment files (never commit real secrets)
.env
.env.*
!**/.env.example

# Go backend build output
/backend/bin/
/backend/dist/

# Embedded web site (built by `make web`)
/backend/web/node_modules/
/backend/web/dist/
